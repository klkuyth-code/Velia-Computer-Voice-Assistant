{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.velia.local/tool-consent-request.v1.schema.json",
  "title": "Velia tool consent request v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "confirmationId", "toolName", "risks", "summary", "expiresAtUtc"],
  "properties": {
    "schema": { "const": "velia-tool-consent-request/v1" },
    "confirmationId": { "type": "string", "format": "uuid" },
    "toolName": { "type": "string", "pattern": "^[a-z][a-z0-9.]{2,63}$" },
    "risks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "uniqueItems": true,
      "items": {
        "enum": [
          "screenCapture",
          "localMutation",
          "destructive",
          "externalCommunication",
          "financial",
          "accountOrSecurityChange"
        ]
      }
    },
    "summary": { "type": "string", "minLength": 1, "maxLength": 1024 },
    "target": { "type": "string", "minLength": 1, "maxLength": 2048 },
    "expiresAtUtc": { "type": "string", "format": "date-time" }
  }
}
