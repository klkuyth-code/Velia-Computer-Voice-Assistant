{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.velia.local/rpc-response.v1.schema.json",
  "title": "Velia RPC response v1",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "id", "ok", "result"],
      "properties": {
        "schema": { "const": "velia-rpc-response/v1" },
        "id": { "type": "string", "format": "uuid" },
        "ok": { "const": true },
        "result": true
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "id", "ok", "error"],
      "properties": {
        "schema": { "const": "velia-rpc-response/v1" },
        "id": { "type": "string", "format": "uuid" },
        "ok": { "const": false },
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "message", "retryable"],
          "properties": {
            "code": { "type": "string", "minLength": 1, "maxLength": 80 },
            "message": { "type": "string", "minLength": 1, "maxLength": 500 },
            "retryable": { "type": "boolean" },
            "details": { "type": "object" }
          }
        }
      }
    }
  ]
}
